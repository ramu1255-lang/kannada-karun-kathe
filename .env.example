# Safe template: intentionally empty. No real credentials belong in this file.
# Copy to .env.local (ignored by the existing *.local rule), then fill locally.

# Public Lovable Cloud configuration; VITE_* values are browser-visible.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# Server-side counterparts of the same project configuration.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_PROJECT_ID=""

# Private AI Gateway credential: server-only. Never prefix with VITE_.
# Leave empty to use basic lessons without live AI translation/fallback speech.
LOVABLE_API_KEY=""